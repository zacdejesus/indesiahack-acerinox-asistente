# Copia este fichero a .env y rellena la clave. .env nunca se sube a git.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Profundidad de razonamiento: low (mas rapido) | medium | high
LLM_EFFORT=medium

# Origen de datos: sqlite (local, sintetico) | databricks (datos del reto)
DATOS_ORIGEN=sqlite
# Solo hacen falta con DATOS_ORIGEN=databricks. El token nunca va en el codigo.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOGO=
DATABRICKS_ESQUEMA=
DATABRICKS_TABLA_INVENTARIO=inventario
DATABRICKS_TABLA_DEMANDA=demanda
DATABRICKS_VOLUMEN_FICHAS=
